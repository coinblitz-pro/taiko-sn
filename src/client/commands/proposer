#!/bin/sh

set -e pipefail

ARGS="--l1.ws ${L1_ENDPOINT_WS}
    --l2.http ${L2_ENDPOINT_HTTP}
    --l2.auth ${L2_ENDPOINT_AUTH}
    --taikoL1 ${TAIKO_L1_ADDRESS}
    --taikoL2 ${TAIKO_L2_ADDRESS}
    --taikoToken ${TAIKO_TOKEN_L1_ADDRESS}
    --jwtSecret ${L2_JWT_SECRET:-/data/taiko-geth/geth/jwtsecret}
    --l1.proposerPrivKey ${PRIVATE_KEY}
    --proverEndpoints ${PROVER_ENDPOINTS}
    --tierFee.optimistic ${PROPOSER_BLOCK_PROPOSAL_FEE_TIER_1:-1}
    --tierFee.sgx ${PROPOSER_BLOCK_PROPOSAL_FEE_TIER_2:-1}
    --tierFee.maxPriceBumps ${PROPOSER_MAX_TIER_FEE_BUMPS:-1}
    --epoch.interval ${PROPOSER_EPOCH_INTERVAL:-12s}
    --epoch.gap ${PROPOSER_EPOCH_GAP:-2m}
    --tx.resubmissionTimeout ${TX_RESUBMISSION:-90s}
    --tx.sendTimeout ${TX_SEND_TIMEOUT:-90s}"

if [ -z "$L1_BLOB_ALLOWED" ]; then
  echo "Error: L1_BLOB_ALLOWED must be non-empty"
  exit 1
fi

taiko-client proposer ${ARGS}
